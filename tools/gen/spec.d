/+ dub.sdl:
    name "spec"
    dependency "parserino" path="../.."
+/
/++
 Extracts from the HTML Living Standard (https://html.spec.whatwg.org/) the inputs of gen_names.d:
 names.txt (elements, their categories in the tree construction, attributes) and entities.tsv
 (name -> UTF-8 hex).

 Usage: dub run --single tools/gen/spec.d [-- dir]   (dir: a local copy of parsing.html, indices.html,
 obsolete.html, semantics-other.html and entities.json; without it they are downloaded)
+/
module spec;

import parserino;
import std.algorithm, std.array, std.conv, std.file, std.format, std.json, std.path, std.regex, std.stdio,
    std.string, std.typecons, std.uni;

string dir;

string load(string name)
{
    import std.net.curl : get;
    if (dir.length) return readText(buildPath(dir, name));
    return get("https://html.spec.whatwg.org/" ~ (name.endsWith(".json") ? name : "multipage/" ~ name)).idup;
}

// The namespace of a name in the lists of the spec: "MathML <code>mi</code>", "SVG <code>desc</code>"
string ns(Element code)
{
    auto t = code.parent.textContent.strip;
    return t.startsWith("MathML") ? "math" : t.startsWith("SVG") ? "svg" : "html";
}

string qualified(Element code) { return ns(code) ~ ":" ~ code.textContent.strip.toLower; }

// The first element after `e` (a following sibling) that matches `css`
Element nextMatching(Element e, string css)
{
    for (auto n = e.nextSibling; n != null; n = n.nextSibling)
        if (n.matches(css)) return n;
    throw new Exception("nothing matches " ~ css ~ " after " ~ e.startTag);
}

void main(string[] args)
{
    if (args.length > 1) dir = args[1];

    auto parsing = Document(load("parsing.html"));
    auto indices = Document(load("indices.html"));
    auto obsolete = Document(load("obsolete.html"));
    auto other = Document(load("semantics-other.html"));

    bool[string] elements;

    // The index of the elements and the obsolete ones
    foreach (c; nextMatching(indices.byId("elements-3"), "table").bySelector("tbody th code"))
        elements[c.textContent.strip] = true;
    auto entirely = obsolete.bySelector("p").filter!(p => p.textContent.canFind("entirely obsolete")).frontOrThrow;
    foreach (c; nextMatching(entirely, "dl").bySelector("dt code")) elements[c.textContent.strip] = true;

    // The tag names in the tree construction rules
    auto rules = parsing.body.textContent.replaceAll(regex(`\s+`), " ");
    foreach (m; rules.matchAll(regex(`tag name is (?:one of: |neither )?((?:"[a-z0-9-]+"(?:,? or |,? and |, | nor )?)+)`)))
        foreach (n; m[1].matchAll(regex(`"([a-z0-9-]+)"`))) elements[n[1]] = true;
    elements.remove("sarcasm");     // "</sarcasm>": a joke of the spec, not an element

    // The SVG names whose case is adjusted
    auto svgTable = parsing.bySelector("table").filter!(t => t.bySelector("tbody td:first-child code").any!(c => c.textContent == "altglyph")).frontOrThrow;
    foreach (c; svgTable.bySelector("tbody td:first-child code")) elements[c.textContent.strip] = true;

    // The categories
    auto special = parsing.byId("special").parent.nextMatching("dd").bySelector("p").frontOrThrow
        .children.filter!(e => e.localName == "code" || e.localName == "a").map!(e => e.localName == "code" ? e : e.bySelector("code").frontOrThrow)
        .map!qualified.array;
    auto formatting = parsing.byId("formatting").parent.nextMatching("dd").bySelector("p code").map!qualified.array;

    string[] scope_;
    string[] items(string id)
    {
        string[] out_;
        foreach (li; parsing.byId(id).parent.nextMatching("ul").children)
        {
            if (li.textContent.canFind("All the element types listed above")) out_ ~= scope_;
            else out_ ~= li.bySelector("code").map!qualified.array;
        }
        return out_;
    }
    scope_ = items("has-an-element-in-scope");
    auto listItem = items("has-an-element-in-list-item-scope");
    auto button = items("has-an-element-in-button-scope");
    auto table = items("has-an-element-in-table-scope");

    foreach (group; [special, formatting, scope_, listItem, button, table])
        foreach (e; group) elements[e.findSplitAfter(":")[1]] = true;
    elements["math"] = elements["svg"] = true;

    // The attributes: the index, the ones compared case-insensitively in selectors
    bool[string] attrs;
    foreach (c; indices.byId("attributes-1").bySelector("tbody th code")) attrs[c.textContent.strip] = true;
    foreach (c; nextMatching(other.byId("case-sensitivity-of-selectors"), "ul").bySelector("li code")) attrs[c.textContent.strip] = true;

    auto o = File(buildPath(__FILE_FULL_PATH__.dirName, "names.txt"), "w");
    o.writeln("# Generated by tools/gen/spec.d from the HTML Living Standard (https://html.spec.whatwg.org/)");
    foreach (s; [tuple("ELEMENTS", elements.keys.sort.release), tuple("SPECIAL", special), tuple("FORMATTING", formatting),
                 tuple("SCOPE", scope_), tuple("SCOPE_LIST_ITEM", listItem), tuple("SCOPE_BUTTON", button),
                 tuple("SCOPE_TABLE", table), tuple("ATTRS", attrs.keys.sort.release)])
    {
        o.writeln(s[0]);
        foreach (i; s[1]) o.writeln("\t", i);
    }
    o.close();

    auto entities = parseJSON(load("entities.json")).object;
    auto e = File(buildPath(__FILE_FULL_PATH__.dirName, "entities.tsv"), "w");
    foreach (name; entities.keys.sort)
    {
        auto value = entities[name]["codepoints"].array.map!(c => cast(dchar) c.integer).to!string;
        e.writefln("%s\t%(%02x%)", name[1 .. $], cast(const(ubyte)[]) value);
    }

    writeln(elements.length, " elements ", attrs.length, " attributes ", entities.length, " entities");
}
