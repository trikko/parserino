/+ dub.sdl:
    name "gen_names"
+/
/++
 Generates source/parserino/names.d and source/parserino/html/entities.d.
 Inputs: names.txt (elements, categories, attribute names) and entities.tsv (name -> UTF-8 hex),
 both extracted from the HTML Living Standard by tools/gen/spec.d.

 It doesn't use parserino, whose sources it writes: it builds even when they don't.

 Usage: dub run --single tools/gen/gen_names.d
+/
module gen_names;

import std.algorithm, std.array, std.conv, std.file, std.format, std.path, std.range, std.stdio, std.string, std.typecons,
    std.uni;

enum here = __FILE_FULL_PATH__.dirName;

// Categories as in the Category enum of names.d, columns as in the Ns enum
enum flags = ["SPECIAL": 0x02, "FORMATTING": 0x04, "SCOPE": 0x08, "SCOPE_LIST_ITEM": 0x10, "SCOPE_BUTTON": 0x20, "SCOPE_TABLE": 0x40];
enum columns = ["html": 2, "math": 3, "svg": 4];
enum nodes = ["#undef", "#end-of-file", "#text", "#document", "!--", "!doctype", "?ProcessingInstruction"];
enum special = ["#undef": "Undef", "#end-of-file": "EndOfFile", "#text": "TextNode", "#document": "DocumentNode",
                "!--": "CommentNode", "!doctype": "DoctypeNode", "?ProcessingInstruction": "ProcessingInstructionNode"];

string[][string] sections;

int[8] categories(string name)
{
    int[8] c;
    foreach (s, f; flags)
        foreach (q; sections[s])
        {
            auto p = q.findSplit(":");
            if (p[2] == name) c[columns[p[0]]] |= f;
        }
    if (c[columns["html"]] == 0) c[columns["html"]] = 0x01;     // ordinary
    return c;
}

/// The enum member of a name, in PascalCase: `annotation-xml` -> `AnnotationXml`
string ident(string n)
{
    if (auto s = n in special) return *s;
    return n.replace("_", "-").split("-").filter!(p => p.length).map!(p => p[0 .. 1].toUpper ~ p[1 .. $]).join;
}

string dstr(string s) { return `"` ~ s.replace(`\`, `\\`).replace(`"`, `\"`) ~ `"`; }

void main()
{
    string section;
    foreach (line; File(buildPath(here, "names.txt")).byLineCopy)
    {
        if (line.empty || line.startsWith("#")) continue;
        if (line.startsWith("\t")) sections[section] ~= line[1 .. $];
        else sections[section = line] = [];
    }

    auto tags = nodes.map!(n => tuple(n, (int[8]).init)).array ~ sections["ELEMENTS"].map!(n => tuple(n, categories(n))).array;
    auto attrs = ["#undef"] ~ sections["ATTRS"];

    auto o = appender!string;
    o ~= q"EOS
/++
 Names of tags, attributes and namespaces.

 Known names have a fixed id (`Tag`, `AttrName`); other names get an id when a
 document meets them (see `NameTable`). Generated by tools/gen/gen_names.d.

 The lists come from the HTML Living Standard (https://html.spec.whatwg.org/), see tools/gen/spec.d.
+/
module parserino.names;

import parserino.arena;

@nogc nothrow pure @safe:

/// Namespaces. `None` is no namespace (as for most attributes); nothing uses `Any`.
enum Ns : ubyte
{
    None, Any, Html, Math, Svg, Xlink, Xml, Xmlns,
}

/++ Known tags. Unknown tag names get ids from `Tag.Last` on.
 + The members are the names in PascalCase (`annotation-xml` is `AnnotationXml`); `Undef`
 + (no tag), `EndOfFile` and the `...Node` members name the nodes that are not elements.
 +/
enum Tag : uint
{
EOS";
    foreach (i, t; tags) o ~= format("    %s = %d,\n", ident(t[0]), i);
    o ~= format("    Last = %d,\n}\n\n", tags.length);

    o ~= "/// Names of the known tags (lowercase)\nimmutable string[Tag.Last] tagNames = [\n";
    foreach (t; tags) o ~= format("    %s,\n", dstr(t[0]));
    o ~= "];\n\n";

    o ~= q"EOS
/// Categories of the tags in the tree construction ("special", "formatting", scopes, ...)
enum Category : ubyte
{
    Ordinary = 0x01,
    Special = 0x02,
    Formatting = 0x04,
    Scope = 0x08,
    ScopeListItem = 0x10,
    ScopeButton = 0x20,
    ScopeTable = 0x40,
}

/// Categories of each tag, for each namespace
immutable ubyte[Ns.max + 1][Tag.Last] tagCategories = [
EOS";
    foreach (t; tags) o ~= format("    [%(%s, %)],\n", t[1][]);
    o ~= "];\n\n";

    o ~= "/++ Known attributes. Unknown names get ids from `AttrName.Last` on.\n + The members are the names in PascalCase (`accept-charset` is `AcceptCharset`); `Undef` is no attribute.\n +/\nenum AttrName : uint\n{\n";
    foreach (i, n; attrs) o ~= format("    %s = %d,\n", n == "#undef" ? "Undef" : ident(n), i);
    o ~= format("    Last = %d,\n}\n\n", attrs.length);
    o ~= "/// Names of the known attributes\nimmutable string[AttrName.Last] attrNames = [\n";
    foreach (n; attrs) o ~= format("    %s,\n", dstr(n));
    o ~= "];\n";

    o ~= q"EOS

/// Id of a known tag (`name` must be lowercase), or `Tag.Undef`
Tag knownTag(scope const(char)[] name) @trusted { return cast(Tag) staticLookup!tagNames(name); }

/// Id of a known attribute (`name` must be lowercase), or `AttrName.Undef`
AttrName knownAttr(scope const(char)[] name) @trusted { return cast(AttrName) staticLookup!attrNames(name); }

///
unittest
{
    assert(knownTag("div") == Tag.Div);
    assert(knownTag("template") == Tag.Template);
    assert(knownTag("nope") == Tag.Undef);
    assert(knownAttr("href") == AttrName.Href);
    static assert(knownTag("svg") == Tag.Svg);
}

/++ Interned names of a document: known names have their static id, the others
 + get new ids (from `first` on) the first time they are seen.
 +/
struct NameTable
{
@nogc nothrow pure @safe:
    @disable this(this);

    /// Id of `name`, adding it if needed. It returns 0 if out of memory.
    uint intern(scope const(char)[] name, ref Arena arena, uint first)
    {
        if (auto id = find(name, first)) return id;

        // A null name marks the empty slots: the empty name is a non-null ""
        const(char)[] copy = name.length ? arena.dup(name) : "";
        if (copy is null) return 0;

        if ((count + 1) * 2 > slots.length && !grow()) return 0;

        names.put(copy);
        if (names.failed) return 0;
        insert(Entry(copy, first + cast(uint) count), hash(name));
        count++;
        return first + cast(uint) count - 1;
    }

    /// Id of `name` if already interned, else 0
    uint find(scope const(char)[] name, uint first) const
    {
        if (slots.length == 0) return 0;

        auto mask = slots.length - 1;
        for (auto i = hash(name) & mask; slots[i].name !is null; i = (i + 1) & mask)
            if (slots[i].name == name) return slots[i].id;

        return 0;
    }

    /// Name of an id (from `first` on)
    const(char)[] name(uint id, uint first) const { return names[id - first]; }

    ~this() @trusted
    {
        import core.memory : pureFree;
        if (!__ctfe && slots.ptr !is null) pureFree(slots.ptr);
    }

    private:

    static struct Entry { const(char)[] name; uint id; }

    Entry[] slots;
    Buffer!(const(char)[]) names;
    size_t count;

    void insert(Entry e, size_t h)
    {
        auto mask = slots.length - 1;
        auto i = h & mask;
        while (slots[i].name !is null) i = (i + 1) & mask;
        slots[i] = e;
    }

    bool grow() @trusted
    {
        import core.memory : pureCalloc, pureFree;

        auto n = slots.length == 0 ? 64 : slots.length * 2;
        Entry[] ns;
        if (__ctfe) ns = new Entry[n];
        else
        {
            auto p = cast(Entry*) pureCalloc(n, Entry.sizeof);
            if (p is null) return false;
            ns = p[0 .. n];
        }

        auto old = slots;
        slots = ns;
        foreach (ref e; old) if (e.name !is null) insert(e, hash(e.name));
        if (!__ctfe && old.ptr !is null) pureFree(old.ptr);
        return true;
    }
}

/// FNV-1a
size_t hash(scope const(char)[] s)
{
    uint h = 2166136261;
    foreach (c; s) { h ^= c; h *= 16777619; }
    return h;
}

private:

// A static hash table (built at compile time) from a list of names to their index
template staticLookup(alias names)
{
    enum size_t size = () {
        size_t n = 1;
        while (n < names.length * 4) n *= 2;
        return n;
    }();

    static immutable ushort[size] table = () {
        ushort[size] t;
        foreach (i, n; names)
        {
            if (i == 0) continue;
            auto j = hash(n) & (size - 1);
            while (t[j] != 0) j = (j + 1) & (size - 1);
            t[j] = cast(ushort) i;
        }
        return t;
    }();

    uint staticLookup(scope const(char)[] name)
    {
        for (auto j = hash(name) & (size - 1); table[j] != 0; j = (j + 1) & (size - 1))
            if (names[table[j]] == name) return table[j];
        return 0;
    }
}
EOS";
    std.file.write(buildPath(here, "../../source/parserino/names.d"), o[]);

    // entities
    string[2][] ents;
    foreach (line; File(buildPath(here, "entities.tsv")).byLineCopy)
    {
        auto p = line.findSplit("\t");
        ents ~= [p[0], p[2]];
    }
    ents.sort!((a, b) => a[0] < b[0]);

    auto e = appender!string;
    e ~= q"EOS
/++
 Named character references of HTML (`&amp;`, `&nbsp;`, ...).
 Generated by tools/gen/gen_names.d.

 The list comes from the HTML Living Standard (https://html.spec.whatwg.org/entities.json),
 see tools/gen/spec.d.
+/
module parserino.html.entities;

@nogc nothrow pure @safe:

/// A named character reference
struct Entity
{
    string name;    /// without '&', with the ';' when it has one
    string value;   /// UTF-8
}

/// All the named character references, sorted by name
static immutable Entity[] entities = [
EOS";
    foreach (n; ents)
        e ~= format("    Entity(%s, \"%-(\\x%s%)\"),\n", dstr(n[0]), iota(0, n[1].length, 2).map!(i => n[1][i .. i + 2]));
    e ~= q"EOS
];

/++ Incremental matching of a name, one char at a time: `entities[lo .. hi]` are the
 + names starting with the chars seen so far. It works across input chunks.
 +/
struct EntityMatcher
{
@nogc nothrow pure @safe:
    size_t lo = 0;              /// the names still possible: `entities[lo .. hi]`
    size_t hi = entities.length;    /// ditto
    size_t depth;       /// chars seen
    size_t best = size_t.max;   /// the longest full match so far (index in `entities`)
    size_t bestLength;  /// its length

    // The names that start with each char: entities[r[0] .. r[1]] (the names are sorted)
    private static immutable ushort[2][128] firstRange = () {
        ushort[2][128] r;
        foreach (i, ref e; entities)
        {
            auto c = e.name[0];
            if (r[c][1] == 0) r[c][0] = cast(ushort) i;
            r[c][1] = cast(ushort) (i + 1);
        }
        return r;
    }();

    /// Feed one char. It returns false when no name can match anymore.
    bool put(char c)
    {
        // The first char: from a table (the widest search)
        if (depth == 0)
        {
            depth = 1;
            if (c >= 128) { lo = hi = 0; return false; }
            lo = firstRange[c][0];
            hi = firstRange[c][1];
            return lo != hi;
        }

        // Narrow [lo, hi) to the names with `c` at position `depth`
        size_t a = lo, b = hi;
        while (a < b)
        {
            auto m = (a + b) / 2;
            auto n = entities[m].name;
            if (n.length <= depth || n[depth] < c) a = m + 1; else b = m;
        }
        size_t first = a;
        b = hi;
        while (a < b)
        {
            auto m = (a + b) / 2;
            auto n = entities[m].name;
            if (n.length > depth && n[depth] <= c) a = m + 1; else b = m;
        }

        lo = first;
        hi = a;
        depth++;
        if (lo == hi) return false;

        if (entities[lo].name.length == depth) { best = lo; bestLength = depth; }
        return true;
    }
}

///
unittest
{
    EntityMatcher m;
    foreach (char c; "notin;") if (!m.put(c)) break;
    assert(entities[m.best].name == "notin;");
    assert(entities[m.best].value == "\u2209");

    EntityMatcher m2;
    foreach (char c; "notit;") if (!m2.put(c)) break;
    assert(entities[m2.best].name == "not");
}
EOS";
    std.file.write(buildPath(here, "../../source/parserino/html/entities.d"), e[]);

    writeln(tags.length, " tags ", attrs.length, " attrs ", ents.length, " entities");
}
